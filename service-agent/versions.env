# Every input the service agent image downloads, pinned by URL, version and
# SHA256 (AGENTS.md, "Every input is pinned"). build.sh refuses to build when
# package.json names another version than this file, and the Dockerfile
# verifies each download against its SHA256.
#
# The base image is pinned by digest twice: here, and in the Dockerfile's
# ARG BASE. build.sh refuses a build where the two differ.
BASE_IMAGE=ubuntu:24.04
BASE_DIGEST=sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# Node: the release the runner images install (toolsets/versions.env), and the
# version service-agent/mise.toml pins. nodejs.org publishes SHASUMS256.txt
# beside the release.
NODE_VERSION=24.22.1
NODE_URL=https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz
NODE_SHA256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6

# Python: the standalone build service-agent/mise.toml pins, from
# python-build-standalone; its release's SHA256SUMS holds this hash.
PYTHON_VERSION=3.13.18
PYTHON_RELEASE=20261026
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-x86_64-unknown-linux-gnu-install_only.tar.gz
PYTHON_SHA256=126343c54daff4068efc1ac269518d0cc202d57857794948103dd1454e8881be

# The agent CLIs and ACP adapters, installed by `npm ci` from package.json and
# package-lock.json, which name the same versions. The lock verifies every
# package's integrity; a changed pin fails npm ci with EINTEGRITY.
CLAUDE_CODE_VERSION=2.1.316
CLAUDE_AGENT_ACP_VERSION=0.99.1
CODEX_VERSION=0.165.0
CODEX_ACP_VERSION=2.5.0
OPENCODE_VERSION=1.19.5

# Codex's npm tarball holds no licence file, so the image takes it from the
# release's tag in the source repository. These are the committed files'
# SHA256s; build.sh checks them.
CODEX_LICENSE_SHA256=d17f227e4df5da1600391338865ce0f3055211760a36688f816941d58232d8dc
CODEX_NOTICE_SHA256=9d71575ecfd9a843fc1677b0efb08053c6ba9fd686a0de1a6f5382fd3c220915
