NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"
GO_URL="https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"
# The same file on the host go.dev redirects to; the image build tries both.
GO_URL_ALT="https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz"
RUSTUP_URL="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init"
DOTNET_URL="https://builds.dotnet.microsoft.com/dotnet/Sdk/${DOTNET_SDK_VERSION}/dotnet-sdk-${DOTNET_SDK_VERSION}-linux-x64.tar.gz"
MISE_URL="https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-x64"

# Docker Engine from Docker's own noble packages, like GitHub's ubuntu-24.04
# image. containerd.io is the newest in Docker's dists/noble/stable index;
# docker-ce and docker-ce-cli are GitHub's 28.0.4 pin. The .deb files are
# pinned by exact name, the plugins by release and SHA256.
DOCKER_VERSION=28.0.4
DOCKER_CE_DEB=docker-ce_28.0.4-1~ubuntu.24.04~noble_amd64.deb
DOCKER_CE_SHA256=fd13d5ecb1e6019ed7ecb6c10b9df67e21ccac7c99906fc95111e8c43e9f2113
