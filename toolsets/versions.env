# Bump a toolset: change its version pin and checksum together from the upstream release.
TOOLSETS="python node go rust dotnet mise docker java cmake gh yq git-lfs"
# Ubuntu's noble-updates packages, checked by major.minor.
PYTHON_SERIES=3.12
NODE_VERSION=24.21.0
NODE_SHA256=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
GO_VERSION=1.27.1
GO_SHA256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
RUSTUP_VERSION=1.29.1
RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
