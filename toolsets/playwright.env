# Playwright's chromium for the opt-in playwright-chromium toolset: the
# playwright-core package, and the Chrome for Testing build 1248 that
# Playwright 1.64.1 downloads for it. The toolset is not in TOOLSETS; a build
# adds it with TOOLSETS="$TOOLSETS playwright-chromium" ./ubuntu-24.04/build.sh.
# These pins stay out of versions.env so the default image's manifest lists
# exactly the pins it did before the toolset existed.
# Chromium is BSD-3-Clause and Playwright Apache-2.0; the Chrome for Testing
# builds Playwright downloads come from cdn.playwright.dev under Google's
# terms, which grant no redistribution right: an image that carries them is
# for measurement and own use until that is cleared.
PLAYWRIGHT_VERSION=1.64.1
PLAYWRIGHT_CORE_URL="https://registry.npmjs.org/playwright-core/-/playwright-core-${PLAYWRIGHT_VERSION}.tgz"
PLAYWRIGHT_CORE_SHA256=3af03703c967c95037454f2283f709d53ce804a4776d4219d319f5bbcc2a0185
PLAYWRIGHT_CHROMIUM_REVISION=1248
PLAYWRIGHT_BROWSER_VERSION=156.0.8078.4
PLAYWRIGHT_CHROMIUM_URL="https://cdn.playwright.dev/builds/cft/${PLAYWRIGHT_BROWSER_VERSION}/linux64/chrome-linux64.zip"
PLAYWRIGHT_CHROMIUM_SHA256=43fd31766c7533a02dda2ded5ad50c2f861cd5400be7509c0abad71129f79d79
PLAYWRIGHT_HEADLESS_SHELL_URL="https://cdn.playwright.dev/builds/cft/${PLAYWRIGHT_BROWSER_VERSION}/linux64/chrome-headless-shell-linux64.zip"
PLAYWRIGHT_HEADLESS_SHELL_SHA256=c3e50596aef52c58f8fda3c6b3411c33d34c88b177b3ed1c2243359fd3b8ba20
