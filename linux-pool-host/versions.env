# Pins of the Linux cloud pool host images. The agent and the guest image
# move together: the guest is the one the agent release names in its
# deploy/images.env, and provision.sh refuses a pair that differs.

# Canonical's Ubuntu 24.04 AMI of this serial. The serial is pinned
# exactly, so the build resolves one AMI per region and never drifts to a
# newer one; it moves on its own, to a serial Canonical publishes on EC2.
# It is not tied to the guest's serial in ubuntu-24.04/versions.env: the
# guest is a separate image that runs inside the host.
UBUNTU_SERIAL=20261023
UBUNTU_AMI_OWNER=099720109477

# Canonical's Azure image of serial 20260926. Its version is a different
# string from the AMI name.
AZURE_UBUNTU_PUBLISHER=Canonical
AZURE_UBUNTU_OFFER=ubuntu-24_04-lts
AZURE_UBUNTU_SKU=server
AZURE_UBUNTU_VERSION=24.04.202609260

# The Toshi agent: the linux_amd64 archive of a Toshi release.
TOSHI_AGENT_VERSION=v0.1.0-rc.7
TOSHI_AGENT_ASSET=toshi_0.1.0-rc.7_linux_amd64.tar.gz
TOSHI_AGENT_SHA256=62792bd3ff5387a9c46e70760bfee526f86a9afbe0d3254d6b9145ae8a5ee217

# The guest image that release names: a toshi-images release of
# ubuntu-24.04, pulled by digest, and the SHA-256 of its qcow2.
GUEST_VERSION=v0.1.22
GUEST_REF=ghcr.io/toshicloud/toshi-images/ubuntu-24.04
GUEST_DIGEST=sha256:87834caa0ee32c5a4cc41e84a5e44efaa434ebd4dd4f89a6a1ce24ee2efdff76
GUEST_SHA256=8a42a63dab8dc20fc697080aa9801da5ea9fdf5d326555b5d66f4f38f4514df0

# ORAS, which pulls the guest image on the build instance.
ORAS_VERSION=1.3.5
ORAS_URL=https://github.com/oras-project/oras/releases/download/v1.3.5/oras_1.3.5_linux_amd64.tar.gz
ORAS_SHA256=f48a73ea6d026a862c3919fc773da9a8c86fc259c2c737d5baed3b8b9614ad22

# passt from the Ubuntu 26.04 archive. Ubuntu 24.04's passt
# (0.0~git20240220) has neither --dns-host nor --map-host-loopback, which
# the agent passes to each VM's passt for its DNS forwarder and for the
# host services it maps into the guests; passt has both from its
# 2024_10_30 release. The package depends only on libc6 (>= 2.38), which
# Ubuntu 24.04 meets, and an LTS release keeps it in its pool.
PASST_VERSION=0.0~git20260120.386b5f5-1
PASST_URL=https://archive.ubuntu.com/ubuntu/pool/universe/p/passt/passt_0.0~git20260120.386b5f5-1_amd64.deb
PASST_SHA256=49eaf773c120432bdf439d26d3de4d9867116580a819e6eba815b600c45b9840

# Packages from the Ubuntu archive, in the versions the archive has at
# build time.
HOST_PACKAGES="qemu-system-x86 qemu-utils ovmf nftables"
