DOTNET_SDK_9_VERSION=9.0.318
DOTNET_SDK_9_URL='https://builds.dotnet.microsoft.com/dotnet/Sdk/9.0.318/dotnet-sdk-9.0.318-win-x64.exe'
DOTNET_SDK_9_CACHE=dotnet-sdk-9.0.318-win-x64.exe
