# Bump Windows media, virtio-win or the runner: change the pinned versions and the
# SHA256SUMS entries together.
WINDOWS_ISO_URL='https://go.microsoft.com/fwlink/?linkid=2345730&clcid=0x409&culture=en-us&country=us'
WINDOWS_ISO_FILE=26100.32230.260111-0550.lt_release_svc_refresh_SERVER_EVAL_x64FRE_en-us.iso
WINDOWS_ISO_BUILD=26100.32230
WINDOWS_IMAGE_NAME="Windows Server 2025 SERVERSTANDARD"
VIRTIO_WIN_VERSION=0.1.302
VIRTIO_WIN_URL='https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win-0.1.302.iso'
RUNNER_VERSION=2.338.0
RUNNER_URL='https://github.com/actions/runner/releases/download/v2.338.0/actions-runner-win-x64-2.338.0.zip'

# Trex Windows CI tools (cache filenames must match SHA256SUMS).
POWERSHELL_7_VERSION=7.6.6
POWERSHELL_7_URL='https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.msi'
POWERSHELL_7_CACHE=powershell-7.6.6-win-x64.msi
GIT_FOR_WINDOWS_VERSION=2.56.0.2
GIT_FOR_WINDOWS_URL='https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/Git-2.56.0.2-64-bit.exe'
GIT_FOR_WINDOWS_CACHE=Git-2.56.0.2-64-bit.exe
RUSTUP_INIT_VERSION=1.29.1
RUSTUP_INIT_URL='https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-pc-windows-msvc/rustup-init.exe'
RUSTUP_INIT_CACHE=rustup-init-1.29.1-x86_64-pc-windows-msvc.exe
# Rust stable as the default (the Linux toolsets' pin), and Trex's lanes' 1.98.1.
RUST_DEFAULT_TOOLCHAIN=1.99.0
RUST_EXTRA_TOOLCHAINS=1.98.1
VS_BUILDTOOLS_VERSION=17.14.41
VS_BUILDTOOLS_URL='https://download.visualstudio.microsoft.com/download/pr/bc92e2cb-33de-4a0c-995d-efa817f16b16/37bb0fb429d163ecebd272a865d11a37b906d152bef960da2ddb29c2e2fd6eeb/vs_BuildTools.exe'
VS_BUILDTOOLS_CACHE=vs_buildtools-17.14.41.exe
SEVENZIP_VERSION=26.04
SEVENZIP_URL='https://github.com/ip7z/7zip/releases/download/26.04/7z2604-x64.msi'
SEVENZIP_CACHE=7z2604-x64.msi
DOTNET_SDK_8_VERSION=8.0.425
DOTNET_SDK_8_URL='https://builds.dotnet.microsoft.com/dotnet/Sdk/8.0.425/dotnet-sdk-8.0.425-win-x64.exe'
DOTNET_SDK_8_CACHE=dotnet-sdk-8.0.425-win-x64.exe
WIX_VERSION=4.0.6
WIX_URL='https://api.nuget.org/v3-flatcontainer/wix/4.0.6/wix.4.0.6.nupkg'
WIX_CACHE=wix.4.0.6.nupkg

# The common CI toolset of GitHub's windows-2025 image (its toolset-2025.json):
# GitHub's pins where it has one (Python 3.12, CMake 3.31.6, Temurin 17 as the
# default JDK), the Linux toolsets' pins (toolsets/versions.env) for Node,
# Go, Temurin, gh and yq, and the newest release for the rest.
PYTHON_VERSION=3.12.10
PYTHON_URL='https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe'
PYTHON_CACHE=python-3.12.10-amd64.exe
NODE_VERSION=24.21.0
NODE_URL='https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip'
