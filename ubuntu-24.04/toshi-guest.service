[Unit]
Description=Toshi guest helper
Wants=dev-virtio\x2dports-toshi.guest.device
After=dev-virtio\x2dports-toshi.guest.device
StartLimitIntervalSec=0
# On EC2, toshi-guest-userdata.service runs the runner instead;
# on GCE, toshi-guest-gce.service; on Azure, toshi-guest-azure.service.
ConditionVirtualization=!amazon
ConditionVirtualization=!google
ConditionVirtualization=!microsoft

[Service]
User=runner
Group=runner
# CAP_NET_BIND_SERVICE: the helper answers the bound-service names on
# 127.84.0.1 port 53, and listens at a bound channel's port, which may be
# below 1024.
# CAP_SYS_ADMIN: the helper freezes the state volume's file system before a
# snapshot of a sleeping service's VM, and clears its ambient set before it
# starts any workload process, so no runner, hook or command inherits it.
AmbientCapabilities=CAP_SYS_TIME CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
WorkingDirectory=/opt/actions-runner
ExecStart=/usr/local/bin/toshi-guest run --transport serial:/dev/virtio-ports/toshi.guest
Restart=on-failure
# The job's processes run in this unit: when the guest kernel's OOM killer
# kills one, the step fails and the runner reports it, rather than systemd
# stopping the runner with it.
OOMPolicy=continue
RestartSec=2s

[Install]
WantedBy=multi-user.target
