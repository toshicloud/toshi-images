[Unit]
Description=Toshi runner from EC2 user data
# Only an EC2 instance of a cloud host; in a Toshi VM toshi-guest.service
# talks to the host over the serial port instead.
ConditionVirtualization=amazon
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
# Root: it deletes cloud-init's copies of the user data, blocks the metadata
# service for other users and arms the shutdown. The runner runs as runner.
User=root
EnvironmentFile=/etc/environment
WorkingDirectory=/opt/actions-runner
ExecStart=/usr/local/bin/toshi-guest userdata
# The user data is read once: no restart.
Restart=no
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
