# The Railpack release the Linux images carry: the CLI and its BuildKit
# frontend. toolsets/railpack.sh installs every version in RAILPACK_VERSIONS
# under /opt/toshi/railpack/<version> and writes the one RAILPACK_VERSION
# names into /opt/toshi/railpack/pinned.
#
# Move the pin on purpose, as guest.env does: add the new version to
# RAILPACK_VERSIONS, change RAILPACK_VERSION, and keep the old lines. A
# version is never removed, so an image rebuilt from an older checkout still
# finds the frontend its pin names.
RAILPACK_VERSIONS="v0.43.0"
RAILPACK_VERSION=v0.43.0

# Per version: the SHA-256 of
# railpack-<version>-x86_64-unknown-linux-musl.tar.gz from that release's
# checksums.txt, and the digest that the frontend's tag in
# ghcr.io/railwayapp/railpack-frontend resolves to. A shell cannot name a
# variable after a dotted version, so a version's dots become underscores.
RAILPACK_CLI_SHA256_v0_43_0=248a8f60f36854aabed6124113631078a802de3461660855fc4de9c26065c1fb
RAILPACK_FRONTEND_DIGEST_v0_43_0=sha256:355ef61fae6f2551103cd8b10c710cb07167dd353d561f15c69b8d7ac1c676cc

# The frontend is copied into an OCI archive with oras, at the version
# mise.toml pins for this repository. The build downloads it, uses it and
# removes it again: the images carry Railpack, not the tool that fetched it.
RAILPACK_ORAS_VERSION=1.3.5
RAILPACK_ORAS_SHA256=f48a73ea6d026a862c3919fc773da9a8c86fc259c2c737d5baed3b8b9614ad22
RAILPACK_ORAS_URL="https://github.com/oras-project/oras/releases/download/v${RAILPACK_ORAS_VERSION}/oras_${RAILPACK_ORAS_VERSION}_linux_amd64.tar.gz"
