# The guest helper the VM images carry: Toshi's CI publishes toshi-guest
# (linux/amd64) and toshi-guest.exe (windows/amd64) as one OCI artefact.
# fetch-guest.sh pulls this digest and checks that the artefact and the Linux
# binary report this version.
TOSHI_GUEST_REF=ghcr.io/toshicloud/toshi-guest
TOSHI_GUEST_VERSION=
TOSHI_GUEST_DIGEST=
